# Copy to .env and adjust. Never commit .env.

# --- docker compose ----------------------------------------------------------
POSTGRES_USER=pasarela
POSTGRES_PASSWORD=pasarela
POSTGRES_DB=pasarela
POSTGRES_PORT=5432
API_PORT=3000
WEB_PORT=4200

# --- API -----------------------------------------------------------------------
NODE_ENV=development
PORT=3000
# Local dev (API on the host, Postgres from `docker compose up -d postgres`).
# Inside docker compose the API uses the "postgres" service host instead.
DATABASE_URL=postgres://pasarela:pasarela@localhost:5432/pasarela
DATABASE_SSL=false
DATABASE_MIGRATIONS_RUN=false
CORS_ORIGINS=http://localhost:4200
TRUST_PROXY=false
LOG_LEVEL=info
SWAGGER_ENABLED=true

# --- Dashboard auth -------------------------------------------------------------
# DEV ONLY placeholder. Generate a real one with: openssl rand -base64 48
JWT_ACCESS_SECRET=dev-only-insecure-secret-change-me-0123456789abcdef
JWT_ACCESS_TTL=15m
JWT_ISSUER=payment-gateway-sim
JWT_AUDIENCE=payment-gateway-sim
REFRESH_TOKEN_TTL_DAYS=7
# 'true' in production (HTTPS). 'false' lets the cookie work over plain http locally.
COOKIE_SECURE=false
AUTH_MAX_FAILED_LOGINS=5
AUTH_LOCK_MINUTES=15

# --- Idempotency & webhooks --------------------------------------------------------
IDEMPOTENCY_KEY_TTL_HOURS=24
WEBHOOK_WORKER_ENABLED=true
WEBHOOK_POLL_INTERVAL_MS=1000
# Retries wait base x5^(n-1): 10 s, 50 s, ~4 min, ~21 min, ~1.7 h (6 attempts in total).
WEBHOOK_RETRY_BASE_SECONDS=10
WEBHOOK_TIMEOUT_MS=5000
# LOCAL DEVELOPMENT ONLY: allows http:// and localhost/private-network receivers (SSRF risk).
WEBHOOK_ALLOW_INSECURE_URLS=true
