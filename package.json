{
  "name": "payment-gateway-sim",
  "version": "0.0.0",
  "private": true,
  "description": "Pasarela de pagos simulada (estilo Stripe, modo test): payment intents, checkout alojado, webhooks firmados — NestJS, PostgreSQL, Angular",
  "license": "MIT",
  "author": "Jhon Maquilon",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JFredMC/payment-gateway-sim.git"
  },
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=24.11.0",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter api --filter web run dev",
    "build": "pnpm -r run build",
    "lint": "pnpm -r run lint",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "test:e2e": "pnpm --filter api run test:e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:domain": "node scripts/domain-sync.mjs",
    "sync:domain": "node scripts/domain-sync.mjs --write"
  },
  "devDependencies": {
    "prettier": "^3.8.1"
  }
}
