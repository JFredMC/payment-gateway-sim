# Copy to .env and adjust. Never commit .env.

# --- docker compose ----------------------------------------------------------
POSTGRES_USER=pasarela
POSTGRES_PASSWORD=pasarela
POSTGRES_DB=pasarela
POSTGRES_PORT=5432
API_PORT=3000
WEB_PORT=4200

# --- API -----------------------------------------------------------------------
NODE_ENV=development
PORT=3000
# Local dev (API on the host, Postgres from `docker compose up -d postgres`).
# Inside docker compose the API uses the "postgres" service host instead.
DATABASE_URL=postgres://pasarela:pasarela@localhost:5432/pasarela
DATABASE_SSL=false
DATABASE_MIGRATIONS_RUN=false
CORS_ORIGINS=http://localhost:4200
TRUST_PROXY=false
LOG_LEVEL=info
SWAGGER_ENABLED=true
